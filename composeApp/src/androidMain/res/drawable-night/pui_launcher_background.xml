            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item
                    android:color="#FF3E3E3E"
                    android:offset="0" />
                <item
                    android:color="#FF060606"
                    android:offset="1" />
